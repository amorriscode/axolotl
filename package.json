{
  "name": "axolotl",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/counter",
    "examples/token-vault",
    "examples/pda-profile",
    "examples/cpi/echo",
    "examples/cpi/relay",
    "conformance",
    "site"
  ],
  "scripts": {
    "test": "npm run test -w @axolotl-sol/compiler && npm run test -w @axolotl-sol/client",
    "build:programs": "node scripts/build-programs.ts",
    "conformance": "node scripts/conformance.ts",
    "devnet:smoke": "node scripts/devnet-smoke.ts",
    "site:build": "npm run build -w site",
    "check-updates": "node scripts/check-updates.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "typescript": "5.9.3"
  }
}
